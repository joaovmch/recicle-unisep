SUPABASE_URL=
SUPABASE_KEY=

# Classificação de resíduo por IA (chat do morador). Gratuito — gere a sua em
# https://aistudio.google.com/apikey. Sem ela, o chat cai sozinho na regra local
# determinística em src/app/shared/data/classificador.ts.
GEMINI_API_KEY=
# Opcional — em branco usa gemini-3.5-flash-lite. Troque quando o Google aposentar o
# modelo (https://ai.google.dev/gemini-api/docs/deprecations).
GEMINI_MODEL=

# Opcional — só em produção atrás de proxy (Nginx, Render…): número de proxies na frente,
# para o limite de uso da IA contar o IP real de cada pessoa. Ex.: 1
TRUST_PROXY=
